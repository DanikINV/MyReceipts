<?xml version="1.0" encoding="utf-8"?>
<!-- Вкладка «Профиль» для админа и менеджера -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MeReceipts.Screen"
    tools:context=".staff.StaffProfileFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/profile_title"
        android:textAppearance="@style/TextAppearance.MeReceipts.Title" />

    <!-- Карточка пользователя -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.MeReceipts.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.MeReceipts.Headline"
                android:textColor="@color/on_primary"
                tools:text="И" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MeReceipts.Body"
                    android:textStyle="bold"
                    tools:text="Иванова Мария Петровна" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MeReceipts.Caption"
                    tools:text="m.ivanova@uk.ru" />

                <!-- В коде: role_admin или role_manager -->
                <TextView
                    android:id="@+id/tvRole"
                    style="@style/Widget.MeReceipts.Badge"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_badge_paid"
                    android:text="@string/role_manager"
                    android:textColor="@color/status_paid_text" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Настройки -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.MeReceipts.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/Widget.MeReceipts.SettingsRow">

                <ImageView
                    style="@style/Widget.MeReceipts.SettingsIcon"
                    android:src="@drawable/ic_bell" />

                <TextView
                    style="@style/Widget.MeReceipts.SettingsLabel"
                    android:text="@string/profile_notifications" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowAppearance"
                style="@style/Widget.MeReceipts.SettingsRow">

                <ImageView
                    style="@style/Widget.MeReceipts.SettingsIcon"
                    android:src="@drawable/ic_nav_profile" />

                <TextView
                    style="@style/Widget.MeReceipts.SettingsLabel"
                    android:text="@string/profile_appearance" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_appearance_value"
                    android:textAppearance="@style/TextAppearance.MeReceipts.Caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSecurity"
                style="@style/Widget.MeReceipts.SettingsRow">

                <ImageView
                    style="@style/Widget.MeReceipts.SettingsIcon"
                    android:src="@drawable/ic_lock" />

                <TextView
                    style="@style/Widget.MeReceipts.SettingsLabel"
                    android:text="@string/profile_security" />

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowHelp"
                style="@style/Widget.MeReceipts.SettingsRow">

                <ImageView
                    style="@style/Widget.MeReceipts.SettingsIcon"
                    android:src="@drawable/ic_help" />

                <TextView
                    style="@style/Widget.MeReceipts.SettingsLabel"
                    android:text="@string/profile_help" />

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MeReceipts.Button.Text"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/action_logout"
        app:icon="@drawable/ic_logout" />
</LinearLayout>
