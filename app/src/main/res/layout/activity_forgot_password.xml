<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран «Восстановление пароля» (макет 390 × 844 dp). Размытие фона в XML недоступно,
    «стекло» собрано из полупрозрачной заливки, светлой обводки и тени.
    Включите edge-to-edge, иначе верх сдвинется на высоту статус-бара.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mr_bg"
    android:clipChildren="true"
    tools:context=".ForgotPasswordActivity">

    <!-- Цветные пятна -->
    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_marginStart="-100dp"
        android:layout_marginTop="-80dp"
        android:background="@drawable/bg_blob_mint_70"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_marginStart="170dp"
        android:layout_marginTop="420dp"
        android:background="@drawable/bg_blob_turquoise_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Назад -->

    <!-- Круг с замком -->
    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_glass_circle"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:outlineAmbientShadowColor="@color/mr_glass_shadow"
        android:outlineSpotShadowColor="@color/mr_glass_shadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_glass_circle"
        android:elevation="4dp"
        android:outlineAmbientShadowColor="@color/mr_glass_shadow"
        android:outlineSpotShadowColor="@color/mr_glass_shadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_icon_lock"
            android:src="@drawable/ic_lock_active" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/MR.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="230dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/nunito_extrabold"
        android:letterSpacing="-0.006"
        android:text="@string/forgot_title"
        android:textColor="@color/mr_text_primary"
        android:textSize="34sp"
        app:lineHeight="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/MR.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:text="@string/forgot_subtitle"
        android:textColor="@color/mr_text_secondary"
        android:textSize="16sp"
        app:lineHeight="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Поле почты (в фокусе) -->
    <TextView
        android:id="@+id/lblEmail"
        style="@style/MR.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:labelFor="@id/etEmail"
        android:fontFamily="@font/nunito_medium"
        android:text="@string/forgot_label_email"
        android:textColor="@color/mr_text_secondary"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fieldEmail"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_field"
        android:elevation="4dp"
        android:outlineAmbientShadowColor="@color/mr_glass_shadow"
        android:outlineSpotShadowColor="@color/mr_glass_shadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblEmail">

        <ImageView
            android:id="@+id/fieldEmailIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="19dp"
            android:contentDescription="@string/cd_icon_mail"
            android:src="@drawable/ic_mail"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/MR.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:autofillHints="emailAddress"
            android:background="@null"
            android:contentDescription="@string/cd_input_email"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="0dp"
            android:hint="@string/forgot_email_sample"
            android:textColor="@color/mr_text_primary"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/fieldEmailIcon"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Отправить ссылку -->

    <!-- Вернуться ко входу (как на скриншоте, чуть левее центра) -->
    <Button
        android:id="@+id/btnSendLink"
        style="@style/MR.Text"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/ripple_button_primary"
        android:elevation="6dp"
        android:fontFamily="@font/nunito_bold"
        android:outlineAmbientShadowColor="@color/mr_button_shadow"
        android:outlineSpotShadowColor="@color/mr_button_shadow"
        android:stateListAnimator="@null"
        android:text="@string/forgot_send_link"
        android:textAllCaps="false"
        android:textColor="@color/mr_text_on_button"
        android:textSize="16sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fieldEmail" />

    <TextView
        android:id="@+id/tvBackToLogin"
        style="@style/MR.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="118.5dp"
        android:layout_marginBottom="32dp"
        android:fontFamily="@font/nunito_semibold"
        android:text="@string/forgot_back_to_login"
        android:textColor="@color/mr_link"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
