<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран «Онбординг 3» (макет 390 × 844 dp).
    Все отступы взяты из макета Figma. Размытие фона (backdrop-blur) в XML недоступно,
    поэтому «стекло» собрано из полупрозрачной заливки, светлой обводки и тени.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mr_bg"
    android:clipChildren="true"
    tools:context=".OnboardingActivity">

    <!-- Размытые цветные пятна -->
    <View
        android:id="@+id/blobTop"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_marginStart="-100dp"
        android:layout_marginTop="-60dp"
        android:background="@drawable/bg_blob_light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/blobBottom"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_marginTop="380dp"
        android:layout_marginEnd="-180dp"
        android:background="@drawable/bg_blob_turquoise"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Пропустить -->

    <!-- Карточка 1 -->
    <TextView
        android:id="@+id/tvSkip"
        style="@style/MR.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/nunito_medium"
        android:text="@string/onboarding_skip"
        android:textColor="@color/mr_text_secondary"
        android:textFontWeight="500"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Карточка 2 (сдвинута вправо) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card1"
        android:layout_width="304dp"
        android:layout_height="@dimen/card_height"
        android:layout_marginStart="40dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="6dp"
        android:outlineAmbientShadowColor="@color/mr_glass_shadow"
        android:outlineSpotShadowColor="@color/mr_glass_shadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/tile1"
            android:layout_width="@dimen/tile_size"
            android:layout_height="@dimen/tile_size"
            android:layout_marginStart="19dp"
            android:background="@drawable/bg_tile_turquoise"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_icon_bell"
                android:src="@drawable/ic_bell" />
        </FrameLayout>

        <TextView
            android:id="@+id/card1Title"
            style="@style/MR.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="21dp"
            android:text="@string/onboarding3_card1_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tile1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/MR.Text.CardSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/onboarding3_card1_subtitle"
            app:layout_constraintEnd_toEndOf="@id/card1Title"
            app:layout_constraintStart_toStartOf="@id/card1Title"
            app:layout_constraintTop_toBottomOf="@id/card1Title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Карточка 3 (уже на 10 dp) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card2"
        android:layout_width="304dp"
        android:layout_height="@dimen/card_height"
        android:layout_marginStart="56dp"
        android:layout_marginTop="208dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="6dp"
        android:outlineAmbientShadowColor="@color/mr_glass_shadow"
        android:outlineSpotShadowColor="@color/mr_glass_shadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/tile2"
            android:layout_width="@dimen/tile_size"
            android:layout_height="@dimen/tile_size"
            android:layout_marginStart="19dp"
            android:background="@drawable/bg_tile_pink"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_icon_drop"
                android:src="@drawable/ic_drop" />
        </FrameLayout>

        <TextView
            android:id="@+id/card2Title"
            style="@style/MR.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="21dp"
            android:text="@string/onboarding3_card2_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tile2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/MR.Text.CardSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/onboarding3_card2_subtitle"
            app:layout_constraintEnd_toEndOf="@id/card2Title"
            app:layout_constraintStart_toStartOf="@id/card2Title"
            app:layout_constraintTop_toBottomOf="@id/card2Title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Заголовок -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card3"
        android:layout_width="294dp"
        android:layout_height="@dimen/card_height"
        android:layout_marginStart="32dp"
        android:layout_marginTop="312dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="6dp"
        android:outlineAmbientShadowColor="@color/mr_glass_shadow"
        android:outlineSpotShadowColor="@color/mr_glass_shadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/tile3"
            android:layout_width="@dimen/tile_size"
            android:layout_height="@dimen/tile_size"
            android:layout_marginStart="19dp"
            android:background="@drawable/bg_tile_mint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_icon_chart"
                android:src="@drawable/ic_chart" />
        </FrameLayout>

        <TextView
            android:id="@+id/card3Title"
            style="@style/MR.Text.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="21dp"
            android:text="@string/onboarding3_card3_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tile3"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/MR.Text.CardSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/onboarding3_card3_subtitle"
            app:layout_constraintEnd_toEndOf="@id/card3Title"
            app:layout_constraintStart_toStartOf="@id/card3Title"
            app:layout_constraintTop_toBottomOf="@id/card3Title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Описание -->
    <TextView
        android:id="@+id/tvTitle"
        style="@style/MR.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="436dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/nunito_extrabold"
        android:letterSpacing="-0.006"
        android:lineSpacingExtra="0dp"
        android:text="@string/onboarding3_title"
        android:textColor="@color/mr_text_primary"
        android:textFontWeight="800"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lineHeight="40sp" />

    <!-- Индикатор страниц (3-я активна) -->
    <TextView
        android:id="@+id/tvDescription"
        style="@style/MR.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="532dp"
        android:layout_marginEnd="24dp"
        android:text="@string/onboarding3_description"
        android:textColor="@color/mr_text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lineHeight="24sp" />

    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        android:layout_marginTop="636dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:layout_width="26dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_active" />
    </LinearLayout>

    <!-- Кнопка «Начнём» -->
    <Button
        android:id="@+id/btnStart"
        style="@style/MR.Text"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="654dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/ripple_button_primary"
        android:elevation="6dp"
        android:fontFamily="@font/nunito_bold"
        android:outlineSpotShadowColor="@color/mr_button_shadow"
        android:outlineAmbientShadowColor="@color/mr_button_shadow"
        android:stateListAnimator="@null"
        android:text="@string/onboarding_start"
        android:textAllCaps="false"
        android:textColor="@color/mr_text_on_button"
        android:textFontWeight="700"
        android:textSize="16sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
