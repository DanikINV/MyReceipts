<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding"
    tools:context=".OnboardingActivity">

    <!--Пропустить-->

    <!--Большая скруглённая карточка-->
    <TextView
        style="@style/MyReceiptsTextSecondaryAction"
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/dp_8"
        android:text="@string/skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <!--Заголовок-->
    <FrameLayout
        android:id="@+id/illustrationCard"
        android:layout_width="@dimen/dp_230"
        android:layout_height="@dimen/dp_299"
        android:layout_marginTop="@dimen/dp_108"
        android:background="@drawable/bg_illustration_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--Белый «листок»-->
        <LinearLayout
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_178"
            android:layout_gravity="center"
            android:background="@drawable/bg_paper"
            android:elevation="@dimen/dp_8"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_14"
            android:paddingTop="@dimen/dp_16">

            <View
                android:layout_width="@dimen/dp_55"
                android:layout_height="@dimen/dp_8"
                android:background="@drawable/bg_bar_teal" />

            <View
                android:layout_width="@dimen/dp_92"
                android:layout_height="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_14"
                android:background="@drawable/bg_bar_gray" />

            <View
                android:layout_width="@dimen/dp_74"
                android:layout_height="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_9"
                android:background="@drawable/bg_bar_gray" />

            <View
                android:layout_width="@dimen/dp_92"
                android:layout_height="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_9"
                android:background="@drawable/bg_bar_gray" />

            <View
                android:layout_width="@dimen/dp_64"
                android:layout_height="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_9"
                android:background="@drawable/bg_bar_gray" />

            <View
                android:layout_width="@dimen/dp_42"
                android:layout_height="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_22"
                android:background="@drawable/bg_bar_dark" />
        </LinearLayout>
    </FrameLayout>

    <!--Подзаголовок-->
<TextView
    style="@style/MyReceiptsTextHeadline"
        android:id="@+id/tvTitle"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_444"
        android:layout_marginEnd="@dimen/dp_24"
        android:lineSpacingExtra="@dimen/dp_minus_6"
        android:text="@string/onboarding_receipt_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <TextView
        style="@style/MyReceiptsTextBody"
        android:id="@+id/tvSubtitle"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_24"
        android:lineSpacingExtra="@dimen/dp_2"
        android:text="@string/onboarding_receipt_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:ignore="HardcodedText" />

    <!--Индикатор страниц-->

    <!--Кнопка «Дальше»-->
    <LinearLayout
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/dot0"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_8"
            android:background="@drawable/bg_indicator_active" />

        <View
            android:id="@+id/dot1"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_8"
            android:background="@drawable/bg_indicator_inactive" />

        <View
            android:id="@+id/dot2"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_8"
            android:background="@drawable/bg_indicator_inactive" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        style="@style/MyReceiptsTextButton"
        android:id="@+id/btnNext"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_56"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"
        android:layout_marginBottom="@dimen/dp_34"
        android:background="@drawable/bg_button_primary"
        android:elevation="@dimen/dp_6"
        android:stateListAnimator="@null"
        android:text="@string/next"
        android:textAllCaps="false"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>