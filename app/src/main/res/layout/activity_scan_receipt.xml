<?xml version="1.0" encoding="utf-8"?>
<!-- Экран камеры: сканирование квитанции (CameraX).
     Тема активности: Theme.MeReceipts.Camera -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_camera"
    android:fitsSystemWindows="true"
    tools:context=".scan.ScanReceiptActivity">

    <!-- Живой превью камеры; если разрешения нет, виден градиентный фон -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- Рамка-подсказка по центру -->
    <View
        android:id="@+id/scanFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_xxl"
        android:layout_marginEnd="@dimen/space_xxl"
        android:background="@drawable/bg_scan_frame"
        app:layout_constraintBottom_toTopOf="@id/tvHint"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintWidth_max="320dp" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="@dimen/camera_button_size"
        android:layout_height="@dimen/camera_button_size"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@drawable/bg_camera_button"
        android:contentDescription="@string/cd_scan_close"
        android:src="@drawable/ic_camera_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- setSelected(true) в коде, когда вспышка включена -->
    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="@dimen/camera_button_size"
        android:layout_height="@dimen/camera_button_size"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_camera_button"
        android:contentDescription="@string/cd_scan_flash"
        android:src="@drawable/ic_camera_flash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/space_xl"
        android:background="@drawable/bg_camera_hint"
        android:gravity="center"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_lg"
        android:text="@string/scan_hint"
        android:textAppearance="@style/TextAppearance.MeReceipts.Body"
        android:textColor="@color/camera_white"
        app:layout_constraintBottom_toTopOf="@id/shutterContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnGallery"
        android:layout_width="@dimen/camera_button_size"
        android:layout_height="@dimen/camera_button_size"
        android:layout_marginStart="@dimen/screen_padding"
        android:background="@drawable/bg_camera_button"
        android:contentDescription="@string/cd_scan_gallery"
        android:src="@drawable/ic_camera_gallery"
        app:layout_constraintBottom_toBottomOf="@id/shutterContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/shutterContainer" />

    <FrameLayout
        android:id="@+id/shutterContainer"
        android:layout_width="@dimen/camera_shutter_outer"
        android:layout_height="@dimen/camera_shutter_outer"
        android:layout_marginBottom="@dimen/space_xl"
        android:background="@drawable/bg_shutter_outer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnShutter"
            android:layout_width="@dimen/camera_shutter_inner"
            android:layout_height="@dimen/camera_shutter_inner"
            android:layout_gravity="center"
            android:background="@drawable/bg_shutter_inner"
            android:contentDescription="@string/cd_scan_shutter" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnManual"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/camera_pill_height"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_camera_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="@dimen/camera_pill_height"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/scan_manual"
        android:textAppearance="@style/TextAppearance.MeReceipts.Body"
        android:textColor="@color/camera_white"
        app:layout_constraintBottom_toBottomOf="@id/shutterContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/shutterContainer" />
</androidx.constraintlayout.widget.ConstraintLayout>
