        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">@dimen/dp_6</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">@dimen/sp_17</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.MeReceipts" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/bg_gradient_end</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.MeReceipts.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.MeReceipts.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.MeReceipts.Amount" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_amount</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.MeReceipts.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.MeReceipts.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.MeReceipts.Badge" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.MeReceipts.Screen" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_screen</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:paddingStart">@dimen/screen_padding</item>
        <item name="android:paddingEnd">@dimen/screen_padding</item>
        <item name="android:paddingTop">@dimen/space_lg</item>
        <item name="android:paddingBottom">@dimen/space_lg</item>
    </style>
    <style name="Widget.MeReceipts.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="iconTint">@color/on_primary</item>
    </style>
    <style name="Widget.MeReceipts.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/primary_link</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.MeReceipts.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
        <item name="android:textColor">@color/primary_link</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.MeReceipts.Button.Danger" parent="Widget.MeReceipts.Button.Text">
        <item name="android:textColor">@color/error</item>
    </style>
    <style name="Widget.MeReceipts.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/icon_default</item>
    </style>
    <style name="Widget.MeReceipts.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">@color/field_bg</item>
        <item name="boxStrokeColor">@color/primary_link</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_width</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_input</item>
        <item name="hintTextColor">@color/primary_link</item>
        <item name="startIconTint">@color/icon_default</item>
    </style>
    <style name="Widget.MeReceipts.Input.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">@color/field_bg</item>
        <item name="boxStrokeColor">@color/primary_link</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_width</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_input</item>
        <item name="hintTextColor">@color/primary_link</item>
    </style>
    <style name="Widget.MeReceipts.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>
    <style name="Widget.MeReceipts.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/field_bg</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="checkedIconTint">@color/on_primary</item>
    </style>
    <style name="Widget.MeReceipts.Badge" parent="TextAppearance.MeReceipts.Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>
    <style name="Widget.MeReceipts.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_lg</item>
        <item name="android:layout_marginEnd">@dimen/space_lg</item>
        <item name="android:layout_marginBottom">@dimen/space_lg</item>
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.MeReceipts.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.MeReceipts.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/status_paid_bg</item>
    </style>
    <style name="Widget.MeReceipts.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="Widget.MeReceipts.SettingsIcon" parent="">
        <item name="android:layout_width">@dimen/icon_size</item>
        <item name="android:layout_height">@dimen/icon_size</item>
        <item name="android:layout_marginEnd">@dimen/space_md</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.MeReceipts.SettingsLabel" parent="TextAppearance.MeReceipts.Body">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="Theme.MeReceipts.Camera">
        <item name="android:navigationBarColor">@color/camera_bg_end</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
