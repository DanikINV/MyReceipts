<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- поле в фокусе -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_code_focused" />
            <stroke
                android:width="1.5dp"
                android:color="@color/code_border_focused" />
            <corners android:radius="@dimen/radius_code" />
        </shape>
    </item>
    <!-- обычное поле -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke
                android:width="1.5dp"
                android:color="@color/white" />
            <corners android:radius="@dimen/radius_code" />
        </shape>
    </item>
</selector>
