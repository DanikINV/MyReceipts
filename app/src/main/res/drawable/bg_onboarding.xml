<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- основа -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/welcome_background" />
        </shape>
    </item>
    <!-- розоватое свечение сверху-слева -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.3"
                android:centerY="0.14"
                android:endColor="@color/onboarding_rose_transparent"
                android:gradientRadius="70%p"
                android:startColor="@color/onboarding_rose"
                android:type="radial" />
        </shape>
    </item>
    <!-- бирюзовое свечение снизу-справа -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.74"
                android:endColor="@color/welcome_glow_transparent"
                android:gradientRadius="60%p"
                android:startColor="@color/welcome_glow_right"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
