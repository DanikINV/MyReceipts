<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- основа -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/welcome_background" />
        </shape>
    </item>
    <!-- бирюзовое свечение сверху-слева -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.25"
                android:centerY="0.06"
                android:endColor="@color/welcome_glow_transparent"
                android:gradientRadius="75%p"
                android:startColor="@color/welcome_glow"
                android:type="radial" />
        </shape>
    </item>
    <!-- бирюзовое пятно справа на уровне подзаголовка -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.55"
                android:endColor="@color/welcome_glow_transparent"
                android:gradientRadius="45%p"
                android:startColor="@color/welcome_glow_right"
                android:type="radial" />
        </shape>
    </item>
    <!-- розоватое пятно слева -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.72"
                android:endColor="@color/welcome_rose_transparent"
                android:gradientRadius="45%p"
                android:startColor="@color/welcome_rose"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
