<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_base" />
        </shape>
    </item>
    <!-- розоватое свечение сверху-справа -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.92"
                android:centerY="0.14"
                android:endColor="@color/glow_pink_end"
                android:gradientRadius="75%p"
                android:startColor="@color/glow_pink"
                android:type="radial" />
        </shape>
    </item>
    <!-- бирюзовое свечение снизу-слева -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.23"
                android:centerY="0.82"
                android:endColor="@color/glow_teal_end"
                android:gradientRadius="60%p"
                android:startColor="@color/glow_teal"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
